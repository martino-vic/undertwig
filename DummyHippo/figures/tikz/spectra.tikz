\begin{tikzpicture}
\begin{axis}[
  width=0.92\linewidth,
  height=6.2cm,
  xlabel={$k$},
  ylabel={amplitude},
  xmin=0,xmax=12,
  ymin=-1.4,ymax=1.6,
  grid=major,
  grid style={hippoMist!80},
  legend style={at={(0.98,0.98)},anchor=north east,font=\scriptsize},
]
\addplot+[domain=0:12,samples=200,thick,hippoCopper]
  {exp(-0.12*x)*sin(deg(x*1.7))};
\addlegendentry{$e^{-0.12k}\sin(1.7k)$}
\addplot+[domain=0:12,samples=200,thick,hippoInk]
  {0.7*cos(deg(x*0.9))};
\addlegendentry{$0.7\cos(0.9k)$}
\addplot+[domain=0:12,samples=120,thick,dashed,orange!80!black]
  {0.25*x*exp(-0.35*x)};
\addlegendentry{envelope proxy}
\addplot[name path=u,domain=0:12,samples=80,draw=none]{0.35};
\addplot[name path=l,domain=0:12,samples=80,draw=none]{-0.35};
\addplot[hippoCopper!25] fill between[of=u and l];
\end{axis}
\end{tikzpicture}
