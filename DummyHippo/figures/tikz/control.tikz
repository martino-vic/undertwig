\begin{tikzpicture}[
  block/.style={draw=hippoInk,thick,align=center,minimum height=1.0cm,
    minimum width=2.2cm,fill=hippoMist!35,rounded corners=1pt},
  sum/.style={circle,draw=hippoCopper,thick,minimum size=7mm,inner sep=0pt},
  arr/.style={-Latex,thick}
]
\node[block] (ref) {$r$};
\node[sum,right=1.0cm of ref] (s1) {};
\node[font=\large,hippoCopper] at (s1) {$+$};
\node[block,right=1.0cm of s1] (K) {$K(s)$};
\node[block,right=1.1cm of K] (P) {$P(s)$};
\node[sum,right=1.0cm of P] (s2) {};
\node[font=\large,hippoCopper] at (s2) {$+$};
\node[block,right=1.0cm of s2] (out) {$y$};
\node[block,below=1.4cm of P,fill=orange!10] (H) {$H(s)$};

\draw[arr] (ref) -- (s1);
\draw[arr] (s1) -- (K);
\draw[arr] (K) -- (P);
\draw[arr] (P) -- (s2);
\draw[arr] (s2) -- (out);
\draw[arr] (P.south) -- ++(0,-0.55) -| (H);
\draw[arr] (H.west) -| ([xshift=-0.55cm]s1.south) -- (s1.south);
\draw[arr] (out.east) -- ++(0.55,0) |- ([yshift=-1.55cm]H.east) -- (H.east);
\draw[arr] ([yshift=0.55cm]H.north) -- ++(0,0.2) -| (s2.south);

\node[font=\scriptsize,hippoCopper,align=center] at ([yshift=0.55cm]s1) {error};
\node[font=\scriptsize,hippoCopper,align=center] at ([yshift=0.55cm]s2) {plant\\noise};
\end{tikzpicture}
